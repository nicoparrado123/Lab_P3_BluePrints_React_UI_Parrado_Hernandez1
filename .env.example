# true = datos en memoria (apimock) · false = backend real (apiclient)
VITE_USE_MOCK=true

# Rutas del backend del Lab P2 (relativas: pasan por el proxy de Vite)
VITE_API_BASE_URL=/api/v1
VITE_AUTH_URL=/auth/login
# Destino del proxy de Vite (solo lo usa vite.config.js)
VITE_BACKEND_URL=http://localhost:8080

# Solo mock: probabilidad 0..1 de que una escritura falle (para ver el rollback optimista)
VITE_MOCK_WRITE_FAIL_RATE=0

# Tiempo real (Lab P4)
VITE_IO_BASE=http://localhost:3001    # Socket.IO (Node)
VITE_STOMP_BASE=http://localhost:8080 # STOMP (Spring Boot)
